{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/schemas/panel_ipw_robustness.schema.json",
  "title": "Panel 12 IPW Robustness (Monetary Severity)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "panel_id",
    "run_id",
    "severity_metric",
    "models",
    "diagnostics",
    "rows"
  ],
  "properties": {
    "panel_id": { "const": "panel12_ipw_robustness_monetary" },
    "run_id": { "type": "string", "minLength": 1 },
    "severity_metric": { "const": "monetary_severity" },
    "subset": { "type": "string", "enum": ["amount_present"] },
    "models": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^gpt-[a-z0-9\\-]+$" }
    },
    "diagnostics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "model",
          "model_obs",
          "positivity_pass",
          "max_weight",
          "rows_emitted",
          "ne_rows"
        ],
        "properties": {
          "model": { "type": "string", "pattern": "^gpt-[a-z0-9\\-]+$" },
          "model_obs": { "type": "integer", "minimum": 0 },
          "positivity_pass": { "type": "boolean" },
          "max_weight": { "type": "number", "minimum": 0 },
          "stabilized": { "type": "boolean" },
          "truncated_at": { "type": ["number", "null"], "minimum": 0 },
          "rows_emitted": { "type": "integer", "minimum": 0 },
          "ne_rows": { "type": "integer", "minimum": 0 },
          "sample_mismatch_reason": { "type": "string" }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": { "$ref": "#/$defs/row" }
    },
    "ne_summary": {
      "type": "array",
      "items": { "$ref": "#/$defs/ne_summary_row" }
    }
  },
  "$defs": {
    "reason_code": {
      "type": "string",
      "enum": [
        "ALL_ZERO_DENOMINATOR",
        "INSUFFICIENT_CELL_N",
        "POSITIVE_OVERLAP_VIOLATION",
        "FILTER_DROPPED_ALL_ROWS",
        "ESTIMATION_FAILED",
        "MISSING_INPUTS",
        "SAMPLE_MISMATCH"
      ]
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "dimension", "status", "n_obs"],
      "properties": {
        "model": { "type": "string", "pattern": "^gpt-[a-z0-9\\-]+$" },
        "dimension": {
          "type": "string",
          "enum": ["age", "geographic", "education", "socioeconomic", "overall"]
        },
        "status": { "type": "string", "enum": ["ok", "ne", "suppressed"] },
        "n_obs": { "type": "integer", "minimum": 0 },
        "estimate": { "type": ["number", "null"] },
        "ci_low": { "type": ["number", "null"] },
        "ci_high": { "type": ["number", "null"] },
        "p_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "q_value": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "ne_reason_code": { "$ref": "#/$defs/reason_code" },
        "note": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "ok" } } },
          "then": {
            "required": ["estimate", "ci_low", "ci_high"],
            "properties": {
              "estimate": { "type": "number" },
              "ci_low": { "type": "number" },
              "ci_high": { "type": "number" },
              "ne_reason_code": false
            }
          }
        },
        {
          "if": { "properties": { "status": { "enum": ["ne", "suppressed"] } } },
          "then": {
            "required": ["ne_reason_code"],
            "properties": {
              "estimate": { "type": "null" },
              "ci_low": { "type": "null" },
              "ci_high": { "type": "null" }
            }
          }
        }
      ]
    },
    "ne_summary_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reason_code", "message"],
      "properties": {
        "model": { "type": "string", "pattern": "^gpt-[a-z0-9\\-]+$" },
        "reason_code": { "$ref": "#/$defs/reason_code" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": { "rows": { "minItems": 1 } },
          "required": ["rows"]
        },
        {
          "properties": { "rows": { "maxItems": 0 }, "ne_summary": { "minItems": 1 } },
          "required": ["rows", "ne_summary"]
        }
      ]
    }
  ]
}
